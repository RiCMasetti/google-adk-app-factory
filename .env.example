AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
BEDROCK_REGION=eu-central-1

# Use the Bedrock model ID or cross-region inference profile ID enabled in your AWS account.
# Keep these values centralized here instead of scattering model IDs through source code.
BEDROCK_ORCHESTRATOR_MODEL_ID=<claude-sonnet-4.6-bedrock-model-or-inference-profile-id>
BEDROCK_SUBAGENT_MODEL_ID=<claude-haiku-4.5-bedrock-model-or-inference-profile-id>

# Bedrock bearer API key consumed by ADK/LiteLLM.
AWS_BEARER_TOKEN_BEDROCK=xxxxxxxxx

WORKSPACE_DIR=./workspace
MAX_AGENT_ITERATIONS=5
AGENT_CALL_TIMEOUT_SECONDS=900
BEDROCK_REQUEST_TIMEOUT_SECONDS=300
SANDBOX_AUTO_START=true

# Optional: increase if LiteLLM background callback logging is noisy on slow terminals.
LOGGING_WORKER_MAX_TIME_PER_COROUTINE=60

# Optional cost estimation. Values are cost per 1M tokens.
ORCHESTRATOR_INPUT_USD_PER_1M=0
ORCHESTRATOR_OUTPUT_USD_PER_1M=0
SUBAGENT_INPUT_USD_PER_1M=0
SUBAGENT_OUTPUT_USD_PER_1M=0
